<Window x:Class="Vackup.AddFolderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add folder" Width="580" SizeToContent="Height" ResizeMode="NoResize"
        FontFamily="{StaticResource UiFont}" Foreground="{DynamicResource Label}"
        Background="{DynamicResource Bg}" UseLayoutRounding="True"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="18">
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="Source folders" Style="{StaticResource CardTitle}" FontSize="15" Foreground="{DynamicResource Label}" Margin="0,0,0,2"/>
                <TextBlock Style="{StaticResource Muted}" Text="Paste one folder path per line."/>
                <TextBox x:Name="SourceBox" Height="96" Margin="0,10,0,0" AcceptsReturn="True" TextWrapping="NoWrap"
                         VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                <Button Content="Browse" Style="{StaticResource SmallButton}" HorizontalAlignment="Left" Margin="0,8,0,0" Click="BrowseSource_Click"/>
            </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="Destination" Style="{StaticResource CardTitle}" FontSize="15" Foreground="{DynamicResource Label}" Margin="0,0,0,2"/>
                <TextBlock Style="{StaticResource Muted}" Text="Leave blank to keep the current destination."/>
                <DockPanel Margin="0,10,0,0">
                    <Button DockPanel.Dock="Right" Content="Browse" Style="{StaticResource SmallButton}" Click="BrowseDestination_Click" Margin="6,0,0,0"/>
                    <TextBox x:Name="DestinationBox"/>
                </DockPanel>
            </StackPanel>
        </Border>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="7,6,7,0">
            <Button Content="Cancel" IsCancel="True"/>
            <Button Content="Add" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Add_Click" Margin="0"/>
        </StackPanel>
    </StackPanel>
</Window>
