<Window x:Class="Vackup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="Assets/Vackup.ico" Title="Vackup" Width="980" Height="720" MinWidth="820" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource UiFont}" Foreground="{DynamicResource Label}"
        Background="{DynamicResource Bg}" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid x:Name="Root">
        <Canvas IsHitTestVisible="False" ClipToBounds="True">
            <Ellipse Width="760" Height="760" Canvas.Left="-200" Canvas.Top="-260">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="{DynamicResource Blob1}" Offset="0"/>
                        <GradientStop Color="Transparent" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse Width="820" Height="820" Canvas.Left="520" Canvas.Top="80">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="{DynamicResource Blob2}" Offset="0"/>
                        <GradientStop Color="Transparent" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse Width="640" Height="640" Canvas.Left="80" Canvas.Top="420">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="{DynamicResource Blob3}" Offset="0"/>
                        <GradientStop Color="Transparent" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
        </Canvas>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                    <TextBlock Text="&#xE8F1;" Style="{StaticResource Icon}" FontSize="18" Foreground="{DynamicResource Tint}"/>
                    <TextBlock Text="Vackup" FontFamily="{StaticResource DisplayFont}" FontSize="15" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Manual folder backup" Style="{StaticResource Muted}" Margin="8,2,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="ThemeButton" Style="{StaticResource ChromeButton}" FontSize="14" Click="ThemeButton_Click" ToolTip="Switch light / dark theme"/>
                    <Button Style="{StaticResource ChromeButton}" Content="&#xE921;" Click="Minimize_Click"/>
                    <Button x:Name="MaxButton" Style="{StaticResource ChromeButton}" Content="&#xE922;" Click="Maximize_Click"/>
                    <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" Click="Close_Click"/>
                </StackPanel>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="13,0,13,13">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource Card}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                    <Button x:Name="RemoveButton" Content="Remove" Style="{StaticResource SmallButton}" Click="RemoveButton_Click" Margin="0,0,6,0"/>
                                    <Button x:Name="AddButton" Content="Add folder" Style="{StaticResource SmallButton}" Click="AddButton_Click"/>
                                </StackPanel>
                                <TextBlock Text="Folders to back up" Style="{StaticResource CardTitle}" FontSize="15" Foreground="{DynamicResource Label}"/>
                            </DockPanel>
                            <ListBox x:Name="SourceList" Grid.Row="1" MinHeight="190" MaxHeight="260" SelectionMode="Extended">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="6,5">
                                            <TextBlock Text="&#xE8B7;" Style="{StaticResource Icon}" FontSize="15" Foreground="{DynamicResource Tint}" Margin="0,0,10,0"/>
                                            <TextBlock Text="{Binding}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>

                    <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Destination" Style="{StaticResource CardTitle}" FontSize="15" Foreground="{DynamicResource Label}" Margin="0,0,0,2"/>
                            <TextBlock Style="{StaticResource Muted}" Text="A drive path (E:\Backups) or network share (\\server\share)."/>
                            <DockPanel Margin="0,10,0,0">
                                <Button x:Name="BrowseButton" DockPanel.Dock="Right" Content="Browse" Style="{StaticResource SmallButton}" Click="BrowseButton_Click" Margin="6,0,0,0"/>
                                <TextBox x:Name="DestinationBox"/>
                            </DockPanel>
                            <TextBlock Text="Options" Style="{StaticResource CardTitle}" FontSize="15" Foreground="{DynamicResource Label}" Margin="0,22,0,4"/>
                            <DockPanel Style="{StaticResource SwitchRow}">
                                <CheckBox x:Name="SkipUnchangedBox" DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="True"/>
                                <TextBlock Text="Skip unchanged files" FontSize="13" VerticalAlignment="Center"/>
                            </DockPanel>
                            <DockPanel Style="{StaticResource SwitchRow}">
                                <CheckBox x:Name="DatedFolderBox" DockPanel.Dock="Right" Style="{StaticResource Switch}"/>
                                <TextBlock Text="Create dated backup folder" FontSize="13" VerticalAlignment="Center"/>
                            </DockPanel>
                            <DockPanel Margin="0,8,0,0">
                                <TextBlock x:Name="SpeedLimitText" DockPanel.Dock="Right" Text="Unlimited" FontSize="13" FontWeight="SemiBold" Width="84" TextAlignment="Right" VerticalAlignment="Center"/>
                                <TextBlock Text="Speed limit" FontSize="13" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <Slider x:Name="SpeedLimitSlider" Minimum="0" Maximum="100" SmallChange="1" LargeChange="5"
                                        IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center"
                                        ValueChanged="SpeedLimitSlider_ValueChanged"
                                        ToolTip="Maximum transfer speed in MB/s. Leftmost is unlimited. Can be changed while copying."/>
                            </DockPanel>
                            <DockPanel Margin="0,4,0,0">
                                <Button x:Name="DetectButton" DockPanel.Dock="Right" Content="Detect" Style="{StaticResource SmallButton}" Click="DetectButton_Click"
                                        ToolTip="Measure the destination write speed and set the slider range to it"/>
                                <TextBlock x:Name="SpeedDetectText" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                    <Button x:Name="CancelButton" Content="Cancel" Style="{StaticResource DangerButton}" IsEnabled="False" Click="CancelButton_Click"/>
                                    <Button x:Name="StartButton" Content="Start backup" Style="{StaticResource PrimaryButton}" Click="StartButton_Click" Margin="0"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Progress" Style="{StaticResource CardTitle}" FontSize="15" Foreground="{DynamicResource Label}" Margin="0,0,0,2"/>
                                    <TextBlock x:Name="PercentText" Text="0%" Style="{StaticResource BigNumber}" Foreground="{DynamicResource Tint}"/>
                                </StackPanel>
                            </DockPanel>
                            <ProgressBar x:Name="Progress" Margin="0,14,0,10"/>
                            <TextBlock x:Name="StatusText" Text="Ready" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock x:Name="StatsText" Style="{StaticResource Muted}" Margin="0,4,0,0"/>
                            <TextBlock x:Name="FileText" Style="{StaticResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
